# Optional. Pre-fills the district StudentVUE URL on the sign-in form.
# PUBLIC_DEFAULT_DISTRICT_URL=https://your-district.edupoint.com

# StudentVUE always runs in the browser through the libcurl.js Worker. The
# current auth flow logs in through StudentVUE's mobile REST API.
PUBLIC_STUDENTVUE_TRANSPORT=libcurl
PUBLIC_STUDENTVUE_AUTH=mobile-rest

# In `astro dev`, a local Wisp relay is served at /wisp/ when this is omitted.
# Production requires the exact Heroku Wisp endpoint, including its path and
# trailing slash. Do not include credentials, a query string, or a fragment.
# PUBLIC_WISP_URL_2=wss://your-heroku-relay.herokuapp.com/

# Legacy only: PUBLIC_WISP_URL referred to the unstable Oracle VM relay. Grade
# Viewer no longer reads it, so it cannot silently become the production relay.
# PUBLIC_WISP_URL=wss://legacy-oracle-relay.example/wisp/

# Required. Anonymous usage counts (client HMAC of email + last sign-in time).
# Create table login_users (email_hash text primary key, last_signed_in timestamptz not null);
# Pepper is public on purpose so the browser can hash before POST /api/login-event.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_LOGIN_HASH_PEPPER=
