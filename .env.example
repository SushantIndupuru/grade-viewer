# Optional. Pre-fills the district StudentVUE URL on the sign-in form.
# PUBLIC_DEFAULT_DISTRICT_URL=https://your-district.edupoint.com

# StudentVUE runs in the browser via libcurl.js. In `astro dev`, a local Wisp
# relay is served at /wisp/ so PUBLIC_WISP_URL can be omitted.
# Production needs a wss:// Wisp relay that may open TCP/443 to Edupoint:
# PUBLIC_WISP_URL=wss://your-wisp-relay.example/

# Required. Anonymous usage counts (client HMAC of email + last sign-in time).
# Create table login_users (email_hash text primary key, last_signed_in timestamptz not null);
# Pepper is public on purpose so the browser can hash before POST /api/login-event.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_LOGIN_HASH_PEPPER=
