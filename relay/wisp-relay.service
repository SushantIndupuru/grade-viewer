[Unit]
Description=Grade Viewer Wisp relay
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/wisp-relay
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=2
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=5001
Environment=ALLOWED_ORIGINS=https://gradeviewer.org,https://www.gradeviewer.org,http://localhost:4321,http://127.0.0.1:4321

[Install]
WantedBy=multi-user.target
