---
import BackLink from '../components/BackLink.astro';
import Layout from '../layouts/Layout.astro';

const forgotPasswordUrl = 'https://ca-pleas.edupoint.com/PXP2_Password_Help.aspx';
---

<Layout title="Sign up · Grade Viewer" description="Set a StudentVUE password so you can sign in to Grade Viewer.">
	<main class="mx-auto w-full max-w-3xl px-4 py-10 pb-16">
		<div class="-ml-1 flex items-center gap-1">
			<BackLink href="/" label="Back" />
			<h1 class="text-xl font-medium">Sign up</h1>
		</div>
		<p class="mt-3 text-sm text-muted-foreground">
			Grade Viewer uses your StudentVUE username and password. If you only sign in with Google, set a
			password first, then come back here.
		</p>

		<ol class="mt-8 space-y-8">
			<li>
				<h2 class="text-base font-medium">1. Set your Password</h2>
				<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
					This will lead you to the Forgot Password site on StudentVUE, but it allows you to set up
					your password for Grade Viewer. This can be the same password as your StudentVUE
					Password.
				</p>
				<p class="mt-3">
					<a
						class="inline-flex h-8 items-center rounded bg-foreground px-2.5 text-sm text-background no-underline hover:opacity-90"
						href={forgotPasswordUrl}
						target="_blank"
						rel="noreferrer"
					>
						Open StudentVUE Forgot Password
					</a>
				</p>
			</li>
			<li>
				<h2 class="text-base font-medium">2. Check your email</h2>
				<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
					After entering your email you should receive an email that will contain a link to set
					your password. (This may take a few minutes.)
				</p>
			</li>
			<li>
				<h2 class="text-base font-medium">3. Set up your new password</h2>
				<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
					You can now set up a text password alongside the default Google signin. This allows you
					to use Grade Viewer.
				</p>
			</li>
			<li>
				<h2 class="text-base font-medium">4. Log in to your account</h2>
				<p class="mt-2 text-sm leading-relaxed text-muted-foreground">
					You’re in! You can now use Grade Viewer.
				</p>
				<p class="mt-3">
					<a
						class="inline-flex h-8 items-center rounded border border-border px-2.5 text-sm text-foreground no-underline hover:bg-muted"
						href="/login"
					>
						Go to sign in
					</a>
				</p>
			</li>
		</ol>
	</main>
</Layout>
