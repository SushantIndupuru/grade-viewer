---
import AppHeader from '../components/AppHeader.astro';
import AppSidebar from '../components/AppSidebar.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Student Info · Grade Viewer">
	<AppSidebar slot="sidebar" section="student-info" />
	<AppHeader section="student-info" />
	<main class="w-full min-w-0 flex-1">
		<section class="mx-auto max-w-2xl px-4 py-6 sm:px-6">
			<div class="border-b border-border pb-5">
				<h1 class="text-lg font-semibold tracking-tight">Student Info</h1>
				<p class="mt-1 text-sm text-muted-foreground">Control how your profile appears on this device.</p>
			</div>
			<div class="flex items-center gap-4 py-6">
				<div class="flex size-16 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-muted-foreground"><svg class="size-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"></circle><path d="M20 21a8 8 0 0 0-16 0"></path></svg></div>
				<div class="min-w-0"><h2 class="truncate text-lg font-medium" data-student-info-name>Student</h2><p class="mt-1 text-sm text-muted-foreground" data-profile-status>Loading profile…</p></div>
			</div>
			<div class="flex flex-wrap items-center justify-between gap-4 border-t border-border py-5">
				<div><h2 class="text-sm font-medium">Profile picture</h2><p class="mt-1 max-w-lg text-sm text-muted-foreground">Use a generic profile picture instead. This preference is stored only in this browser.</p></div>
				<button type="button" class="shrink-0 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium hover:bg-muted" data-profile-toggle>Hide picture</button>
			</div>
			<div class="flex flex-wrap items-center justify-between gap-4 border-t border-border py-5" data-remembered-signin>
				<div><h2 class="text-sm font-medium">Remembered sign-in</h2><p class="mt-1 max-w-lg text-sm text-muted-foreground">This browser can automatically sign you in. Remove it on a shared or no-longer-trusted device.</p></div>
				<button type="button" class="shrink-0 rounded-md border border-input bg-background px-4 py-2 text-sm font-medium hover:bg-muted" data-forget-device>Forget this device</button>
			</div>
		</section>
	</main>
</Layout>

<script>
	import { forgetSavedSignIn, getSession } from '../lib/session';
	const key = 'gradeviewer.profile-photo-hidden.v1';
	const session = await getSession();
	const name = session?.student?.name || session?.creds.username || 'Student';
	document.querySelector('[data-student-info-name]')!.textContent = name;
	const status = document.querySelector<HTMLElement>('[data-profile-status]')!;
	const toggle = document.querySelector<HTMLButtonElement>('[data-profile-toggle]')!;
	let hidden = localStorage.getItem(key) === 'true';
	function paint() {
		status.textContent = hidden ? 'Default profile picture in use' : 'No profile picture available';
		toggle.textContent = hidden ? 'Show picture' : 'Hide picture';
	}
	paint();
	toggle.addEventListener('click', () => { hidden = !hidden; localStorage.setItem(key, String(hidden)); paint(); });
	document.querySelector<HTMLButtonElement>('[data-forget-device]')?.addEventListener('click', async (event) => {
		await forgetSavedSignIn();
		(event.currentTarget as HTMLButtonElement).disabled = true;
		(event.currentTarget as HTMLButtonElement).textContent = 'Forgotten';
	});
</script>
