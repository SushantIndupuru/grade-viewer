---
import AppHeader from '../components/AppHeader.astro';
import AppSidebar from '../components/AppSidebar.astro';
import Layout from '../layouts/Layout.astro';

const period = Astro.url.searchParams.get('period') ?? '';
const refresh = Astro.url.searchParams.has('refresh');
const periodQuery = period ? `?period=${encodeURIComponent(period)}` : '';
const payload = JSON.stringify({
	gradebook: null,
	fetchedAt: 0,
	period,
	refresh,
}).replaceAll('<', '\\u003c');
---

<Layout title="Grades · Grade Viewer">
	<AppSidebar slot="sidebar" courses={[]} periodQuery={periodQuery} />
	<AppHeader periodQuery={periodQuery} section="grades" />

	<main class="w-full min-w-0 flex-1">
		<div id="grades-app">
			<div class="min-h-[calc(100vh-53px)] bg-background px-3 pb-4 sm:px-5 sm:pb-5 md:px-9 md:pb-9" aria-busy="true">
				<div class="flex justify-center py-3"><div class="h-9 w-full max-w-60 animate-pulse rounded-md bg-muted"></div></div>
				<p class="sr-only" role="status">Loading grades</p>
				<ol class="space-y-3 sm:space-y-4" aria-hidden="true">
					{Array.from({ length: 6 }).map(() => <li><div class="flex min-h-[4.5rem] items-center gap-3 rounded-xl border border-border bg-card p-3.5 shadow-sm sm:min-h-24 sm:gap-5 sm:p-5"><div class="size-10 shrink-0 animate-pulse rounded-full bg-muted sm:size-12"></div><div class="min-w-0 flex-1 space-y-2"><div class="h-4 w-2/5 max-w-64 animate-pulse rounded bg-muted sm:h-5"></div><div class="h-3 w-1/4 max-w-36 animate-pulse rounded bg-muted"></div></div><div class="space-y-2 text-right"><div class="ml-auto h-5 w-14 animate-pulse rounded bg-muted sm:h-6 sm:w-16"></div><div class="ml-auto h-3 w-14 animate-pulse rounded bg-muted sm:w-20"></div></div></div></li>)}
				</ol>
			</div>
		</div>
		<script id="grades-bootstrap" type="application/json" set:html={payload} />
	</main>
</Layout>

<script>
	import { mountGradesList } from '../components/grades-list';

	const node = document.querySelector('#grades-bootstrap');
	const root = document.querySelector('#grades-app');
	if (node && root) {
		mountGradesList(root, JSON.parse(node.textContent || '{}'));
	}
</script>
