---
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const SITE_NAME = 'Grade Viewer';
const site = Astro.site ?? new URL('https://gradeviewer.org');
const { title = SITE_NAME, description = 'View StudentVUE grades, assignment impact, and local what-if scores.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-background text-foreground">
		{Astro.slots.has('sidebar') ? (
			<div class="flex min-h-0 flex-1">
				<slot name="sidebar" />
				<div class="flex min-h-0 min-w-0 flex-1 flex-col">
					<slot />
					<SiteFooter />
				</div>
			</div>
		) : (
			<>
				<slot />
				<SiteFooter />
			</>
		)}
	</body>
</html>
