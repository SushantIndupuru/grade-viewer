---
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import { THEME_COOKIE, isTheme } from '../lib/theme';

interface Props {
	title?: string;
	description?: string;
}

const SITE_NAME = 'Grade Viewer';
const site = Astro.site ?? new URL('https://gradeviewer.org');
const { title = SITE_NAME, description = 'Grade Viewer is no longer available.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site);
const themeCookie = Astro.cookies.get(THEME_COOKIE)?.value;
const theme = isTheme(themeCookie) ? themeCookie : null;
---

<!doctype html>
<html lang="en" class:list={[{ dark: theme === 'dark' }]} style={theme ? `color-scheme: ${theme}` : undefined}>
	<head>
		<script is:inline>
			(() => {
				const match = document.cookie.match(/(?:^|; )gv_theme=([^;]*)/);
				const stored = match ? decodeURIComponent(match[1]) : '';
				const dark =
					stored === 'dark' ||
					(stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.classList.toggle('dark', dark);
				document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
			})();
		</script>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-background text-foreground">
		<slot />
		<SiteFooter />
	</body>
</html>

<script>
	import { bindThemeControls } from '../lib/theme';
	import { wipeDeviceData } from '../lib/wipe-device';

	bindThemeControls();
	void wipeDeviceData();
</script>
