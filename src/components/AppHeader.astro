---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	name?: string;
	school?: string;
	periods?: { index: string; gradePeriod: string }[];
	selectedPeriod?: string;
	periodQuery?: string;
	section?: 'grades' | 'documents' | 'attendance' | 'mail' | 'student-info';
}

const { name = '', school = '', periods = [], selectedPeriod = '', periodQuery = '', section = 'grades' } = Astro.props;
const isCoursePage = /^\/grades\/\d+\/?$/.test(Astro.url.pathname);
---

<header class:list={[
	'sticky top-0 z-30 flex items-center gap-2 border-b border-border bg-card/60 p-2 backdrop-blur',
	isCoursePage ? 'min-h-[76px]' : 'min-h-[53px]',
]}>
	<details class="relative md:hidden">
		<summary class="flex size-7 cursor-pointer list-none items-center justify-center rounded-md hover:bg-muted" aria-label="Open navigation">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path></svg>
		</summary>
		<nav class="absolute left-0 top-9 z-50 w-48 rounded-md border border-border bg-card p-1 shadow-md" aria-label="App">
			<a class="block rounded-sm px-2 py-1.5 text-sm hover:bg-muted" href={`/grades${periodQuery}`}>Grades</a>
			<a class="block rounded-sm px-2 py-1.5 text-sm hover:bg-muted" href="/attendance">Attendance</a>
			<a class="block rounded-sm px-2 py-1.5 text-sm hover:bg-muted" href="/mail">Mail</a>
			<a class="block rounded-sm px-2 py-1.5 text-sm hover:bg-muted" href="/documents">Documents</a>
			<a class="block rounded-sm px-2 py-1.5 text-sm hover:bg-muted" href="/student-info">Student Info</a>
			<div class="my-1 h-px bg-border"></div>
			<div class="flex items-center justify-between gap-2 px-2 py-1">
				<span class="text-sm text-muted-foreground">Appearance</span>
				<ThemeToggle />
			</div>
			<button class="flex w-full items-center rounded-sm px-2 py-1.5 text-left text-sm hover:bg-muted" type="button" data-signout>Log out</button>
		</nav>
	</details>
	<button type="button" class="hidden size-7 items-center justify-center rounded-md hover:bg-muted md:flex" data-sidebar-toggle aria-label="Collapse sidebar">
		<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path></svg>
	</button>
	<div class="flex min-w-0 flex-1 items-center justify-between gap-4 pr-2">
		<p class:list={['truncate font-semibold tracking-tight text-foreground/80', isCoursePage && 'text-xl sm:text-2xl']} data-page-title>{section === 'grades' ? 'Grades' : section === 'mail' ? 'Mail' : section === 'attendance' ? 'Attendance' : section === 'student-info' ? 'Student Info' : 'Documents'}</p>
		<p class="shrink-0 text-xl font-semibold tabular-nums text-foreground/80 sm:text-2xl" data-page-grade hidden></p>
		<div class:list={[isCoursePage ? 'hidden' : 'ml-auto flex items-center gap-2']} data-header-actions>
			<button type="button" class="ml-auto hidden size-9 items-center justify-center rounded-md border border-input bg-background p-0 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground md:h-9 md:w-auto md:px-3" data-command-trigger aria-label="Search classes and assignments">
				<svg class="size-4 md:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><span class="hidden items-center gap-1.5 md:flex"><kbd class="font-sans text-xs">⌘</kbd><span class="text-muted-foreground/70">+</span><kbd class="font-sans text-xs">K</kbd></span>
			</button>
			<div id="period-host" hidden>
				{periods.length > 0 && (
					<form>
						<label class="sr-only" for="period">Term</label>
						<select
							id="period"
							name="period"
							class="h-8 rounded border border-border bg-background px-2 text-sm"
							onchange="this.form.submit()"
						>
							{periods.map((item) => (
								<option value={item.index} selected={item.index === selectedPeriod}>
									{item.gradePeriod}
								</option>
							))}
						</select>
					</form>
				)}
			</div>
		</div>
	</div>
</header>

<div class="fixed inset-0 z-50 hidden items-start justify-center px-4 pt-[18vh]" data-command-dialog>
	<button type="button" class="absolute inset-0 bg-background/70 backdrop-blur-sm" data-command-close aria-label="Close search"></button>
	<div class="relative w-full max-w-xl overflow-hidden rounded-xl border border-border bg-card text-card-foreground shadow-2xl" role="dialog" aria-modal="true" aria-label="Search classes and assignments">
		<div class="flex items-center gap-3 border-b border-border px-4"><svg class="size-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg><input class="h-12 min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground" data-command-input placeholder="Search classes and assignments..." /><kbd class="rounded border border-border px-1.5 py-0.5 text-[11px] text-muted-foreground">Esc</kbd></div>
		<div class="max-h-[50vh] overflow-y-auto p-2" data-command-results></div>
	</div>
</div>

<script>
	import { applyStudentHeader, requireSession, signOut } from '../lib/session';

	const session = await requireSession();
	if (session) applyStudentHeader(session);

	document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]')?.addEventListener('click', (event) => {
		const sidebar = document.querySelector<HTMLElement>('[data-app-sidebar]');
		if (!sidebar) return;
		const collapsed = sidebar.classList.toggle('sidebar-collapsed');
		sidebar.classList.toggle('w-12', collapsed);
		sidebar.classList.toggle('w-64', !collapsed);
		(event.currentTarget as HTMLButtonElement).setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
	});

	document.querySelectorAll<HTMLButtonElement>('[data-signout]').forEach((button) => button.addEventListener('click', async () => {
		button.disabled = true;
		await signOut();
		location.assign('/');
	}));
</script>
