---
import { displayCourseTitle } from '../lib/grades/display';

interface Props {
	courses?: { title: string }[];
	periodQuery?: string;
	activeIndex?: number;
	section?: 'grades' | 'documents' | 'attendance' | 'mail' | 'student-info';
}

const { courses = [], periodQuery = '', activeIndex, section = 'grades' } = Astro.props;

const itemClass = (active: boolean) => [
	'flex min-h-11 items-center gap-3 rounded-lg px-3 py-2.5 text-base no-underline md:min-h-0 md:gap-2 md:rounded-md md:px-2 md:py-1.5 md:text-sm',
	active
		? 'bg-muted font-medium text-foreground'
		: 'text-muted-foreground hover:bg-muted/60 hover:text-foreground',
];
---

<div
	class="fixed inset-0 z-40 hidden bg-background/60 backdrop-blur-sm md:hidden"
	data-nav-backdrop
></div>
<aside
	id="app-sidebar"
	class="flex h-svh w-64 shrink-0 flex-col border-r border-sidebar-border bg-sidebar text-sidebar-foreground overscroll-contain transition-[width] duration-200 ease-out max-md:fixed max-md:inset-y-0 max-md:left-0 max-md:z-50 max-md:!w-[min(19rem,88vw)] max-md:max-w-xs max-md:-translate-x-full max-md:shadow-xl max-md:transition-transform max-md:data-[open]:translate-x-0 md:sticky md:top-0"
	data-app-sidebar
	aria-label="Student navigation"
>
	<div class="flex min-h-0 flex-1 flex-col overflow-y-auto px-2 py-3">
		<div class="mb-3 flex items-center gap-1">
			<a
				href={`/grades${periodQuery}`}
				data-grades-home
				class="flex h-11 min-w-0 flex-1 items-center px-2 text-xl font-bold tracking-tight text-sidebar-foreground no-underline md:h-8"
				aria-label="Grade Viewer"
			>
				<img src="/favicon.svg" alt="" class="size-6 shrink-0 rounded" width="24" height="24" /><span class="ml-2" data-sidebar-full>gradeviewer</span>
			</a>
			<button
				type="button"
				class="flex size-11 shrink-0 items-center justify-center rounded-md hover:bg-muted md:hidden"
				data-nav-close
				aria-label="Close menu"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
			</button>
		</div>
		<nav class="flex min-h-0 flex-1 flex-col gap-0.5" aria-label="Sections">
			<div class="min-h-0">
				<a
					href={`/grades${periodQuery}`}
					data-grades-home
					class:list={itemClass(section === 'grades' && activeIndex == null)}
					aria-current={section === 'grades' && activeIndex == null ? 'page' : undefined}
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0" aria-hidden="true">
						<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"></path>
						<path d="M8 11h8"></path>
						<path d="M8 7h6"></path>
					</svg>
					<span data-sidebar-label>Grades</span>
				</a>
				<div id="course-nav" class="mt-0.5 ml-4 border-l border-border pl-1.5" data-sidebar-label aria-label="Classes">
					<ul class="flex flex-col gap-px">
						{courses.map((course, index) => {
							const title = displayCourseTitle(course.title);
							const active = section === 'grades' && index === activeIndex;
							return (
								<li class="min-w-0">
									<a
										href={`/grades/${index}${periodQuery}`}
										class:list={[
											'flex min-h-11 items-center truncate rounded-lg px-3 py-2.5 text-base no-underline md:min-h-0 md:rounded-md md:px-2 md:py-1.5 md:text-sm',
											active
												? 'bg-muted font-medium text-foreground'
												: 'text-muted-foreground hover:bg-muted/60 hover:text-foreground',
										]}
										aria-current={active ? 'page' : undefined}
										title={title}
									>
										{title}
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			</div>
			<a href="/attendance" class:list={itemClass(section === 'attendance')} aria-current={section === 'attendance' ? 'page' : undefined}>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4 shrink-0" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>
				<span data-sidebar-label>Attendance</span>
			</a>
			<a href="/mail" class:list={itemClass(section === 'mail')} aria-current={section === 'mail' ? 'page' : undefined}>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4 shrink-0" aria-hidden="true"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"></path></svg>
				<span data-sidebar-label>Mail</span>
			</a>
			<a
				href="/documents"
				class:list={itemClass(section === 'documents')}
				aria-current={section === 'documents' ? 'page' : undefined}
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0" aria-hidden="true">
					<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path>
					<path d="M14 2v5a1 1 0 0 0 1 1h5"></path>
					<path d="M10 9H8"></path>
					<path d="M16 13H8"></path>
					<path d="M16 17H8"></path>
				</svg>
				<span data-sidebar-label>Documents</span>
			</a>
		</nav>
	</div>
	<footer class="flex flex-col gap-2 p-2">
		<details class="group/account relative" data-account-menu>
			<summary class="flex min-h-12 w-full cursor-pointer list-none items-center gap-2 rounded-lg p-2 transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring md:min-h-0 md:rounded-md">
				<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-muted"><svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"></circle><path d="M20 21a8 8 0 0 0-16 0"></path></svg></span>
				<p class="min-w-0 flex-1 truncate text-left text-xs font-medium leading-tight" data-student-name data-sidebar-label>Student</p>
				<svg class="ml-auto size-4 opacity-60 transition-transform group-open/account:rotate-180" data-sidebar-label xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 15-6-6-6 6"></path></svg>
			</summary>
			<div class="absolute bottom-[calc(100%+0.375rem)] left-0 z-50 w-[min(16rem,calc(100%-0.5rem))] rounded-md border border-border bg-card p-1 text-card-foreground shadow-md">
				<p class="px-2 py-1.5 text-xs font-medium">Account</p>
				<div class="my-1 h-px bg-border"></div>
				<a href="/student-info" class="flex min-h-11 items-center gap-2 rounded-sm px-2 text-base no-underline hover:bg-muted md:h-8 md:min-h-0 md:text-sm"><svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="5"></circle><path d="M20 21a8 8 0 0 0-16 0"></path></svg>Student Info</a>
				<p class="px-2 pb-1 pt-2 text-xs font-medium text-muted-foreground">Appearance</p>
				<button type="button" class="flex min-h-11 w-full items-center gap-2 rounded-sm px-2 text-left text-base hover:bg-muted md:h-8 md:min-h-0 md:text-sm" data-theme-choice="dark"><svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>Dark mode<svg class="ml-auto hidden size-4" data-theme-check="dark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg></button>
				<button type="button" class="flex min-h-11 w-full items-center gap-2 rounded-sm px-2 text-left text-base hover:bg-muted md:h-8 md:min-h-0 md:text-sm" data-theme-choice="light"><svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41-1.41"></path></svg>Light mode<svg class="ml-auto hidden size-4" data-theme-check="light" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"></path></svg></button>
				<div class="my-1 h-px bg-border"></div>
				<button class="flex min-h-11 w-full items-center gap-2 rounded-sm px-2 text-left text-base hover:bg-muted md:h-8 md:min-h-0 md:text-sm" type="button" data-signout><svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>Log out</button>
			</div>
		</details>
	</footer>
</aside>
