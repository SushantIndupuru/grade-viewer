---
import { CONTACT_EMAIL, SOURCE_URL } from '../lib/config';
import ThemeToggle from './ThemeToggle.astro';
---

<footer class="mt-auto border-t border-border">
	<div class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3 text-xs text-muted-foreground">
		<p>Grade Viewer is no longer available.</p>
		<nav class="flex items-center gap-3">
			<ThemeToggle />
			<a class="text-inherit underline" href="/privacy">Privacy</a>
			<a class="text-inherit underline" href={`mailto:${CONTACT_EMAIL}`}>Contact</a>
			<a class="text-inherit underline" href={SOURCE_URL} target="_blank" rel="noopener noreferrer">Source</a>
		</nav>
	</div>
</footer>
