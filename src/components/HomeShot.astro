---
interface Props {
	name: 'grades' | 'course' | 'mail' | 'attendance' | 'documents';
	alt: string;
	width: number;
	height: number;
	class?: string;
	eager?: boolean;
}

const { name, alt, width, height, class: className, eager = false } = Astro.props;
---

<picture class:list={['block w-full', className]}>
	<source srcset={`/home/${name}-dark.png`} media="(prefers-color-scheme: dark)" />
	<img
		src={`/home/${name}-light.png`}
		alt={alt}
		width={width}
		height={height}
		sizes="(min-width: 64rem) 52rem, 90vw"
		class="h-auto w-full select-none"
		draggable="false"
		decoding="async"
		loading={eager ? 'eager' : 'lazy'}
		fetchpriority={eager ? 'high' : undefined}
	/>
</picture>
